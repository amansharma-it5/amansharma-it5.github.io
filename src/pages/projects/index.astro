---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectExplorer from '../../components/ProjectExplorer';
import { projects } from '../../data/projects';
---
<BaseLayout title="Project archive — Aman Sharma" description="A verified archive of Aman Sharma's Android products, live websites, business builds and learning experiments.">
  <section class="archive-hero section-grid">
    <div class="shell archive-hero__inner"><p class="eyebrow"><span>ARCHIVE / 07</span> Verified project inventory</p><h1>Everything I’ve<br /><em>put into motion.</em></h1><p>Public work is linked. Private builds are described from reviewed project documentation. Nothing here is inflated beyond the evidence.</p><div class="archive-hero__meta"><span>{projects.length.toString().padStart(2, '0')} projects</span><span>Android / Web / Code</span><span>Updated September 2026</span></div></div>
  </section>
  <section class="archive-list section-grid"><div class="shell"><ProjectExplorer client:visible={{ rootMargin: '350px' }} /></div></section>
</BaseLayout>
