---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual';
import ScrollStory from '../../components/ScrollStory';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<BaseLayout title={`${project.name} — Aman Sharma`} description={project.summary}>
  <article class="case-study">
    <section class="case-hero section-grid"><div class="shell case-hero__grid"><div class="case-hero__copy reveal-on-scroll"><a class="back-link" href="/projects/">← Back to archive</a><p class="eyebrow"><span>{project.eyebrow}</span> Case study</p><h1>{project.name}<br /><em>{project.category}</em></h1><p class="case-summary">{project.summary}</p><div class="case-hero__actions">{project.live && <a class="button button--primary" href={project.live} target="_blank" rel="noreferrer">Open live surface <span>↗</span></a>}{project.repo && <a class="text-link" href={project.repo} target="_blank" rel="noreferrer">View public repository <span>↗</span></a>}{project.privateRepo && <span class="private-note">Private repository · details kept intentionally high-level</span>}</div></div><div class="case-hero__visual reveal-on-scroll"><ProjectVisual project={project} large /><div class="case-hero__stamp">{project.status} <span>·</span> {project.confidence}</div></div></div></section>
    <section class="case-overview section-grid"><div class="shell"><div class="case-overview__grid"><div><p class="eyebrow"><span>01</span> The brief</p><h2>Make the<br /><em>signal useful.</em></h2></div><div class="case-overview__copy"><p class="large-copy">{project.problem}</p><div class="case-facts"><div><span>Built for</span><strong>{project.audience}</strong></div><div><span>Status</span><strong>{project.status}</strong></div><div><span>Evidence</span><strong>{project.source}</strong></div></div></div></div></div></section>
    <section class="case-stage section-grid"><div class="shell"><div class="section-heading section-heading--tight"><div><p class="eyebrow"><span>02</span> The system</p><h2>Details make<br /><em>the difference.</em></h2></div><p class="section-intro">A scroll-led view of the verified product decisions behind this build. The media stays quiet so the evidence can lead.</p></div><ScrollStory client:load project={project} beats={project.story} /></div></section>
    <section class="case-features section-grid"><div class="shell"><div class="section-heading section-heading--tight"><div><p class="eyebrow"><span>03</span> What’s documented</p><h2>Visible<br /><em>building blocks.</em></h2></div><p class="section-intro">A focused view of the parts that are supported by the reviewed project evidence.</p></div><div class="feature-grid">{project.features.map((feature, index) => <div class="feature-item"><span>{String(index + 1).padStart(2, '0')}</span><strong>{feature}</strong></div>)}</div></div></section>
    <section class="case-close section-grid"><div class="shell case-close__inner"><div><p class="eyebrow"><span>04</span> The honest state</p><h2>{project.journey}</h2></div><a class="arrow-link" href="/projects/">Return to the archive <span>↗</span></a></div></section>
  </article>
</BaseLayout>
