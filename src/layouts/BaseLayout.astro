---
import '../styles/global.css';
import '../styles/future.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Aman Sharma — Product builder & creative technologist',
  description = 'Aman Sharma builds thoughtful Android products, useful web tools and expressive interfaces from first principle to shipped surface.',
  image = '/assets/images/social-card.jpg'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const absoluteImage = new URL(image, Astro.site ?? Astro.url).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06101d" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link id="async-web-fonts" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&amp;family=Manrope:wght@400;500;600;700;800&amp;display=swap" media="(min-width: 621px)" />
    <script is:inline>
      const webFonts = document.getElementById('async-web-fonts');
      if (webFonts instanceof HTMLLinkElement && window.matchMedia('(min-width: 621px)').matches) webFonts.addEventListener('load', () => { webFonts.media = 'all'; }, { once: true });
    </script>
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&amp;family=Manrope:wght@400;500;600;700;800&amp;display=swap" /></noscript>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aman Sharma — Portfolio" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aman Sharma — independent product builder and technical talent partner." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content="Aman Sharma — independent product builder and technical talent partner." />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Aman Sharma',
      url: 'https://amansharma-it5.github.io',
      email: 'mailto:amansharma.i5@gmail.com',
      sameAs: ['https://www.linkedin.com/in/amansharmanm/', 'https://github.com/amansharma-it5']
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class={`site-header${Astro.url.pathname === '/' ? ' site-header--home' : ''}`}>
      <div class="shell site-header__inner">
        <a class="wordmark" href="/"><span aria-hidden="true">AS</span><em>AMAN SHARMA</em></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation"><span class="sr-only">Toggle navigation</span><i /><i /></button>
        <nav id="site-navigation" class="site-nav" aria-label="Primary navigation">
          <a href="/#highlights">Work <span>01</span></a>
          <a href="/#about">About <span>02</span></a>
          <a href="/#comparison">Archive <span>03</span></a>
          <a href="/#contact">Contact <span>04</span></a>
        </nav>
        <a class="header-status" href="mailto:amansharma.i5@gmail.com"><i />Open to thoughtful work</a>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p>© {new Date().getFullYear()} Aman Sharma. Built with curiosity.</p>
        <div><a href="https://github.com/amansharma-it5" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/amansharmanm/" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="mailto:amansharma.i5@gmail.com">Email ↗</a></div>
      </div>
    </footer>
    <script>
      const renderSignals = {
        reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
        constrained: Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData),
        lowMemory: Boolean((navigator as Navigator & { deviceMemory?: number }).deviceMemory && ((navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 0) <= 2)
      };
      // Keep the first mobile task semantic. The immersive islands perform their own
      // capability checks when they are intentionally requested; probing WebGL here
      // used to create a synchronous, expensive context on every mobile visit.
      document.documentElement.dataset.renderTier = renderSignals.reducedMotion || renderSignals.constrained || renderSignals.lowMemory ? 'dom' : 'adaptive';
      document.documentElement.dataset.webgpu = 'gpu' in navigator ? 'available-for-future-enhancement' : 'unavailable';

      const revealItems = Array.from(document.querySelectorAll<HTMLElement>('.reveal-on-scroll'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const compactViewport = window.matchMedia('(max-width: 620px)').matches;
      if (reducedMotion || compactViewport || !('IntersectionObserver' in window)) {
        revealItems.forEach((element) => element.classList.add('is-visible'));
      } else {
        // Let the first paint settle before enabling the reveal state. Intersection
        // Observer will handle in-view content without forcing a document-wide
        // synchronous geometry pass during startup.
        window.requestAnimationFrame(() => document.documentElement.classList.add('motion-ready'));
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.05 });
        revealItems.filter((element) => !element.classList.contains('is-visible')).forEach((element) => revealObserver.observe(element));
      }

      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector('#site-navigation');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        navigation?.classList.toggle('is-open', !open);
      });
      navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        navigation?.classList.remove('is-open');
      }));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
          menuButton.setAttribute('aria-expanded', 'false');
          navigation?.classList.remove('is-open');
          menuButton.focus();
        }
      });
    </script>
  </body>
</html>
